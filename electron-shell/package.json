{
  "name": "pocket-pirate",
  "version": "0.1.1",
  "description": "Pocket Pirate desktop app",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.pocketpirate.app",
    "productName": "Pocket Pirate",
    "directories": {
      "output": "../dist-electron"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "rjPajaro",
      "repo": "pocket-pirate-app"
    },
    "extraFiles": [
      { "from": "splash.html", "to": "splash.html" },
      { "from": "preload.js",  "to": "preload.js"  }
    ],
    "extraResources": [
      {
        "from": "resources/api",
        "to": "api",
        "filter": ["**/*"]
      },
      {
        "from": "resources/app",
        "to": "app",
        "filter": ["**/*"]
      }
    ]
  }
}
